{
  "name": "@tickernelz/wardmote",
  "version": "0.3.1",
  "description": "Wardmote CLI — orchestrate AI agent teams to run a business",
  "type": "module",
  "bin": {
    "wardmote": "./dist/index.js"
  },
  "keywords": [
    "paperclip",
    "ai",
    "agents",
    "orchestration",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/wardmote",
    "directory": "cli"
  },
  "homepage": "https://github.com/tickernelz/wardmote",
  "bugs": {
    "url": "https://github.com/tickernelz/wardmote/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "wardmoteReleasePackages": [
    "@tickernelz/wardmote",
    "@tickernelz/wardmote-adapter-omp-local",
    "@tickernelz/wardmote-adapter-utils",
    "@tickernelz/wardmote-create-plugin",
    "@tickernelz/wardmote-db",
    "@tickernelz/wardmote-mcp-server",
    "@tickernelz/wardmote-plugin-cloudflare-sandbox",
    "@tickernelz/wardmote-plugin-daytona",
    "@tickernelz/wardmote-plugin-e2b",
    "@tickernelz/wardmote-plugin-exe-dev",
    "@tickernelz/wardmote-plugin-kubernetes",
    "@tickernelz/wardmote-plugin-modal",
    "@tickernelz/wardmote-plugin-novita-sandbox",
    "@tickernelz/wardmote-plugin-sdk",
    "@tickernelz/wardmote-plugin-workspace-diff",
    "@tickernelz/wardmote-server",
    "@tickernelz/wardmote-shared",
    "@tickernelz/wardmote-skills-catalog",
    "@tickernelz/wardmote-teams-catalog",
    "@tickernelz/wardmote-ui"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node --input-type=module -e \"import esbuild from 'esbuild'; import config from './esbuild.config.mjs'; await esbuild.build(config);\" && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@tickernelz/wardmote-adapter-omp-local": "workspace:*",
    "@tickernelz/wardmote-adapter-utils": "workspace:*",
    "@tickernelz/wardmote-db": "workspace:*",
    "@tickernelz/wardmote-server": "workspace:*",
    "@tickernelz/wardmote-shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "dotenv": "^17.4.2",
    "commander": "^15.0.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
