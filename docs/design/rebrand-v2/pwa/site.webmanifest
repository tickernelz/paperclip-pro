{
  "id": "/",
  "name": "Wardmote",
  "short_name": "Wardmote",
  "description": "Run a company of AI agents: tasks, decisions, approvals and live runs.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "theme_color": "#f6f7f9",
  "background_color": "#f6f7f9",
  "categories": [
    "productivity",
    "business",
    "developer"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "/icon-any-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-any-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.jpg",
      "sizes": "1800x1125",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Home: what needs you and who is working"
    },
    {
      "src": "/screenshot-narrow.jpg",
      "sizes": "780x1688",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Inbox on a phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-any-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Decisions",
      "short_name": "Decisions",
      "url": "/inbox/decisions?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-any-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tasks",
      "short_name": "Tasks",
      "url": "/tasks?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-any-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New task",
      "short_name": "New task",
      "url": "/tasks/new?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icon-any-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
