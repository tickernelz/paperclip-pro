{
  "name": "@tickernelz/wardmote-adapter-omp-local",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/tickernelz/wardmote",
  "bugs": {
    "url": "https://github.com/tickernelz/wardmote/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/wardmote",
    "directory": "packages/adapters/omp-local"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./ui": "./src/ui/index.ts",
    "./cli": "./src/cli/index.ts",
    "./readiness": "./src/server/readiness.ts",
    "./providers": "./src/server/providers.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./readiness": {
        "types": "./dist/server/readiness.d.ts",
        "import": "./dist/server/readiness.js"
      },
      "./providers": {
        "types": "./dist/server/providers.d.ts",
        "import": "./dist/server/providers.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tickernelz/wardmote-adapter-utils": "workspace:*",
    "@tickernelz/wardmote-mcp-server": "workspace:*",
    "@tickernelz/wardmote-shared": "workspace:*",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
