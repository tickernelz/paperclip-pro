{
  "name": "@tickernelz/paperclip-pro-shared",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/tickernelz/paperclip-pro",
  "bugs": {
    "url": "https://github.com/tickernelz/paperclip-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/paperclip-pro",
    "directory": "packages/shared"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./telemetry": {
        "types": "./dist/telemetry/index.d.ts",
        "import": "./dist/telemetry/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/cliplab && cp src/cliplab/LICENSE src/cliplab/PROVENANCE.md dist/cliplab/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "@types/three": "0.186.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
