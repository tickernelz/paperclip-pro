{
  "name": "@tickernelz/wardmote-plugin-authoring-smoke-example",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A Wardmote plugin",
  "scripts": {
    "prebuild": "pnpm --filter @tickernelz/wardmote-plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "wardmote-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @tickernelz/wardmote-plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "wardmotePlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "connector"
  ],
  "author": "Plugin Author",
  "license": "MIT",
  "dependencies": {
    "@tickernelz/wardmote-plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.68.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
