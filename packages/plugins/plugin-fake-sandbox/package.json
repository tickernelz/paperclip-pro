{
  "name": "@tickernelz/wardmote-plugin-fake-sandbox",
  "version": "0.1.0",
  "description": "First-party deterministic fake sandbox provider plugin for Wardmote environments",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "wardmotePlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @tickernelz/wardmote-plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @tickernelz/wardmote-plugin-sdk ensure-build-deps && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@tickernelz/wardmote-plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
