[Unit]
Description=Wardmote agent orchestrator
Requires=wardmote-db.service
After=wardmote-db.service

[Container]
Image=paperclip-local
ContainerName=wardmote
Pod=wardmote.pod
Volume=%h/.local/share/paperclip:/paperclip:Z
Environment=HOST=0.0.0.0
Environment=WARDMOTE_HOME=/paperclip
Environment=WARDMOTE_DEPLOYMENT_MODE=authenticated
Environment=WARDMOTE_DEPLOYMENT_EXPOSURE=private
Environment=WARDMOTE_PUBLIC_URL=http://localhost:3100
EnvironmentFile=%h/.config/containers/systemd/paperclip.env

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
