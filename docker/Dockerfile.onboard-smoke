FROM ubuntu:24.04

ARG NODE_MAJOR=24
ARG WARDMOTE_VERSION=latest
ARG HOST_UID=10001
ARG OMP_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
  WARDMOTE_HOME=/wardmote \
  WARDMOTE_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3100 \
  HOME=/home/wardmote \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  WARDMOTE_VERSION=${WARDMOTE_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && test -n "${OMP_VERSION}" \
  && curl -fsSL https://omp.sh/install | PI_INSTALL_DIR=/usr/local/bin sh -s -- --binary --ref "v${OMP_VERSION}" \
  && test "$(omp --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)" = "${OMP_VERSION}" \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 wardmote \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 wardmote \
  && mkdir -p /wardmote /home/wardmote/workspace \
  && chown -R wardmote:wardmote /wardmote /home/wardmote \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/wardmote"]
WORKDIR /home/wardmote/workspace
EXPOSE 3100
USER wardmote

# --bind lan is required: `onboard --yes` without an explicit --bind prefers
# trusted-local defaults, which write a loopback bind into the instance config
# and ignore the deployment env vars. A loopback listener inside the container
# is unreachable through Docker's port mapping, so the smoke health check can
# never pass without this flag.
CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$WARDMOTE_HOME\"; npx --yes \"@tickernelz/wardmote@${WARDMOTE_VERSION}\" onboard --yes --bind lan --data-dir \"$WARDMOTE_HOME\""]
