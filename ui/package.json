{
  "name": "@tickernelz/wardmote-ui",
  "version": "0.3.1",
  "description": "Prebuilt Paperclip board UI assets.",
  "license": "MIT",
  "homepage": "https://github.com/tickernelz/wardmote",
  "bugs": {
    "url": "https://github.com/tickernelz/wardmote/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/wardmote",
    "directory": "ui"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 -c storybook/.storybook",
    "build-storybook": "storybook build -c storybook/.storybook -o storybook-static",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist dist-preview storybook-static tsconfig.tsbuildinfo",
    "prepack": "rm -f package.dev.json && cp package.json package.dev.json && node ../scripts/generate-ui-package-json.mjs",
    "postpack": "if [ -f package.dev.json ]; then mv package.dev.json package.json; fi"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/link": "0.53.0",
    "@mdxeditor/editor": "^4.5.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.107.1",
    "@tickernelz/wardmote-adapter-omp-local": "workspace:*",
    "@tickernelz/wardmote-adapter-utils": "workspace:*",
    "@tickernelz/wardmote-shared": "workspace:*",
    "@xterm/addon-clipboard": "0.3.0-beta.313",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-image": "0.10.0-beta.310",
    "@xterm/addon-search": "0.17.0-beta.310",
    "@xterm/addon-unicode11": "0.10.0-beta.310",
    "@xterm/addon-web-links": "0.13.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/xterm": "6.1.0-beta.315",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.7.2",
    "lexical": "0.53.0",
    "lucide-react": "^1.70.0",
    "mermaid": "^11.17.2",
    "motion": "^13.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.19.1",
    "react-router-dom": "^7.18.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@sentry/browser": "10.71.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@tickernelz/wardmote-plugin-sdk": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
