{
  "manifest_version": 2,
  "name": "Paperclip Local Browser Bridge",
  "short_name": "Paperclip Browser",
  "version": "1.1.1",
  "description": "Lets Paperclip drive your own Firefox tabs: snapshot, act, read, screenshot, network and trusted input. You choose every permission.",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-browser@paperclip.app",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "contextualIdentities",
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "<all_urls>",
    "tabs",
    "scripting",
    "cookies",
    "downloads",
    "downloads.open",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "history",
    "bookmarks",
    "browsingData",
    "sessions",
    "topSites",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "management",
    "privacy",
    "search",
    "proxy",
    "tabHide",
    "find",
    "browserSettings"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "lib/contract.js",
      "lib/ext-api.js",
      "lib/access.js",
      "lib/guards.js",
      "lib/headers.js",
      "lib/api-call.js",
      "lib/pairing.js",
      "lib/protocol.js",
      "lib/backoff.js",
      "lib/ring.js",
      "lib/text.js",
      "lib/keys.js",
      "lib/cursor.js",
      "lib/input.js",
      "lib/frames.js",
      "lib/budget.js",
      "background/network.js",
      "background/tabs.js",
      "background/bidi.js",
      "background/cookies.js",
      "background/downloads.js",
      "background/tools.js",
      "background/bridge.js",
      "background/index.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/protocol.js",
        "lib/text.js",
        "lib/refmap.js",
        "lib/cursor.js",
        "lib/snapshot.js",
        "lib/markdown.js",
        "lib/dom-adapter.js",
        "lib/document-state.js",
        "lib/keys.js",
        "lib/input.js",
        "content/agent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "Paperclip Local Browser",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "ui/control.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
