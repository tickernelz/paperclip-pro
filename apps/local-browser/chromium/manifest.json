{
  "manifest_version": 3,
  "name": "Paperclip Local Browser Bridge",
  "version": "1.0.4",
  "description": "Connects this browser to a paired Paperclip server so an agent can read and drive real tabs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "cookies",
    "downloads",
    "debugger",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Paperclip Local Browser",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/protocol.js",
        "lib/text.js",
        "lib/refmap.js",
        "lib/snapshot.js",
        "lib/markdown.js",
        "lib/cursor.js",
        "lib/attachments.js",
        "lib/frames.js",
        "lib/hit.js",
        "lib/dom-adapter.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
